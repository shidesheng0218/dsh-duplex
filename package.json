{
  "name": "dsh-duplex",
  "version": "0.0.1",
  "description": "Hands-free voice mode for DeepSeek Harness: read replies aloud, dictate into the composer, approve by voice. 语音双工：说需求、听结论、语音审批。",
  "type": "module",
  "exports": {
    ".": "./host/index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host",
    "client",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "voice",
    "speech",
    "tts",
    "hands-free",
    "accessibility"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shidesheng0218/dsh-duplex.git"
  }
}
