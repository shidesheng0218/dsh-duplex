{
  "name": "dsh-duplex",
  "version": "0.1.0",
  "description": "Hands-free voice mode for DeepSeek Harness: read replies aloud, dictate, answer approvals by voice with high-risk double confirmation. 语音双工：说需求、听结论、语音审批。",
  "type": "module",
  "scripts": {
    "check": "node --check host/index.js && node --check client/client.js",
    "test": "node scripts/smoke.mjs"
  },
  "exports": {
    ".": "./host/index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host",
    "client",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "voice",
    "speech",
    "tts",
    "hands-free",
    "accessibility",
    "voice-approval",
    "approvals",
    "speech-synthesis",
    "deepseek"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shidesheng0218/dsh-duplex.git"
  }
}
